---
import { Image } from "astro:assets";
import avatarImage from "../../../assets/images/avatar.jpg";
import activityData from "../../../data/activity.json";
import statusData from "../../../data/author-status.json";
import {
	ACTIVITY_BLOCK_COLORS,
	type ActivityData,
	type ActivityPeriod,
	activityBlockCount,
	activityPointLabel,
	isActivityPartial,
	selectActivityRange,
} from "../../../utils/activity";
import { translations } from "../../../utils/translations";

// 数値のフォーマット
const formatNumber = (num: number) =>
	new Intl.NumberFormat("ja-JP").format(num);

const lastSync = statusData.lastUpdated
	? new Date(statusData.lastUpdated).toLocaleString("ja-JP", {
			year: "numeric",
			month: "2-digit",
			day: "2-digit",
			hour: "2-digit",
			minute: "2-digit",
			timeZone: "Asia/Tokyo",
			timeZoneName: "short",
		})
	: "---";

const activity = activityData as ActivityData;
const initialPeriod: ActivityPeriod = "90d";
const periodLabels: Record<ActivityPeriod, string> = {
	"90d": "Last 90 days",
	"12m": "Last 12 months",
	all: "All time",
};

const initialActivityPoints = selectActivityRange(activity, initialPeriod);
const initialHasActivity = initialActivityPoints.some(
	(point) => activityBlockCount(point) > 0,
);

function activityLabelIsVisible(index: number, length: number): boolean {
	return index % Math.ceil(length / 4) === 0 || index === length - 1;
}
---

<div class="w-full max-w-[1160px] mx-auto text-sm sm:text-base">
	<div
		class="flex flex-col w-full font-mono bg-[color:var(--panel-bg)] border border-[color:var(--panel-border)] rounded-xl shadow-[var(--card-shadow)] overflow-hidden backdrop-blur-sm"
	>
		<div class="p-6 border-b border-[color:var(--panel-border)]">
			<div class="profile-header">
				<Image
					src={avatarImage}
					data-lang-ja={translations.ja["avatar.alt"]}
					data-lang-en={translations.en["avatar.alt"]}
					alt={translations.ja["avatar.alt"]}
					class="profile-avatar border-[color:var(--panel-border)]"
					width={80}
					height={80}
					loading="eager"
				/>
				<div>
					<div class="flex items-center gap-3">
						<p class="profile-name" style="margin-bottom: 0;">HappyOnigiri</p>
						<div class="flex items-center gap-2">
							<a
								href="https://x.com/HappyOnigiri_W"
								target="_blank"
								rel="noopener noreferrer"
								class="text-[color:var(--text-muted)] hover:text-[color:var(--accent-main)] transition-colors"
								><svg
									class="w-4 h-4"
									fill="currentColor"
									viewBox="0 0 24 24"
									aria-hidden="true"
									><path
										d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 22.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"
									></path></svg
								></a
							>
							<a
								href="https://github.com/HappyOnigiri"
								target="_blank"
								rel="noopener noreferrer"
								class="text-[color:var(--text-muted)] hover:text-[color:var(--text-main)] transition-colors"
								><svg
									class="w-4.5 h-4.5"
									fill="currentColor"
									viewBox="0 0 24 24"
									aria-hidden="true"
									><path
										fill-rule="evenodd"
										d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"
										clip-rule="evenodd"></path></svg
								></a
							>
							<a
								href="https://zenn.dev/happy_onigiri"
								target="_blank"
								rel="noopener noreferrer"
								class="transition-colors"
								aria-label="Zenn"
							>
								<img
									src="/images/logos/logo_zenn.svg"
									alt="Zenn"
									class="w-4 h-4"
								/>
							</a>
							<a
								href="https://note.com/happy_onigiri"
								target="_blank"
								rel="noopener noreferrer"
								class="transition-colors"
								aria-label="note"
							>
								<img
									src="/images/logos/logo_note.svg"
									alt="note"
									class="w-4 h-4"
								/>
							</a>
						</div>
					</div>
					<p class="profile-bio" data-i18n="bio" data-i18n-html>
						思いつきでドリブン開発をしています。<br />
						ジャンルは問わず「面白そう」「あったら便利そう」と思ったものを形にしています。<br
						/>
						感想・質問・雑談など <a
							href="https://x.com/HappyOnigiri_W"
							class="profile-link"
							target="_blank"
							rel="noopener noreferrer">X</a
						> でお気軽にどうぞ！
					</p>
				</div>
			</div>
		</div>
		<div
			class="px-6 pt-5 pb-1 flex flex-wrap items-baseline justify-between gap-x-4"
		>
			<h2 class="section-heading" style="margin-bottom: 0;">
				Development Status
			</h2>
			<span class="text-xs text-[color:var(--text-muted)] font-mono"
				>Last Updated: {lastSync}</span
			>
		</div>
		<div class="p-6 overflow-x-auto">
			<div class="flex flex-wrap gap-4 text-[color:var(--text-main)]">
				<div
					class="flex-1 min-w-[140px] bg-[color:var(--bg-color)] border border-[color:var(--panel-border)] p-4 rounded-xl"
				>
					<div
						class="text-[color:var(--text-muted)] text-xs font-semibold tracking-wider mb-2"
					>
						Changed Lines
					</div>
					<div
						class="text-2xl font-bold font-mono text-[color:var(--text-main)]"
					>
						{formatNumber(statusData.addedLines + statusData.deletedLines)}
					</div>
				</div>
				<div
					class="flex-1 min-w-[140px] bg-[color:var(--bg-color)] border border-[color:var(--panel-border)] p-4 rounded-xl"
				>
					<div
						class="text-[color:var(--text-muted)] text-xs font-semibold tracking-wider mb-2"
					>
						Commits
					</div>
					<div
						class="text-2xl font-bold font-mono text-[color:var(--text-main)]"
					>
						{formatNumber(statusData.commits)}
					</div>
				</div>
				<div
					class="flex-1 min-w-[140px] bg-[color:var(--bg-color)] border border-[color:var(--panel-border)] p-4 rounded-xl"
				>
					<div
						class="text-[color:var(--text-muted)] text-xs font-semibold tracking-wider mb-2"
					>
						Merged PRs
					</div>
					<div
						class="text-2xl font-bold font-mono text-[color:var(--text-main)]"
					>
						{formatNumber(statusData.mergedPRs)}
					</div>
				</div>
				<div
					class="flex-1 min-w-[140px] bg-[color:var(--bg-color)] border border-[color:var(--panel-border)] p-4 rounded-xl"
				>
					<div
						class="text-[color:var(--text-muted)] text-xs font-semibold tracking-wider mb-2"
					>
						CI Runs
					</div>
					<div
						class="text-2xl font-bold font-mono text-[color:var(--text-main)]"
					>
						{formatNumber(statusData.ciRuns)}
					</div>
				</div>
				{
					((statusData as { ossPRs?: number }).ossPRs ?? 0) > 0 && (
						<div class="flex-1 min-w-[140px] bg-[color:var(--bg-color)] border border-[color:var(--panel-border)] p-4 rounded-xl">
							<div class="text-[color:var(--text-muted)] text-xs font-semibold tracking-wider mb-2">
								OSS PRs
							</div>
							<div class="text-2xl font-bold font-mono text-[color:var(--text-main)]">
								{formatNumber((statusData as { ossPRs?: number }).ossPRs!)}
							</div>
						</div>
					)
				}
			</div>
			<section
				class="cyber-activity"
				data-activity-root
				aria-labelledby="cyber-activity-heading"
			>
				<div class="cyber-activity-header">
					<div>
						<p class="cyber-activity-eyebrow">Activity</p>
						<h3 id="cyber-activity-heading" class="cyber-activity-title">
							Development activity
						</h3>
					</div>
					<div class="cyber-activity-controls">
						<div
							class="cyber-activity-control-group"
							role="group"
							aria-label="Activity period"
							data-activity-period-group
						>
							{
								(["90d", "12m", "all"] as ActivityPeriod[]).map((period) => (
									<button
										type="button"
										class="cyber-activity-control"
										data-activity-period={period}
										aria-pressed={period === initialPeriod}
									>
										{periodLabels[period]}
									</button>
								))
							}
						</div>
					</div>
				</div>
				<div
					class="cyber-activity-chart-shell"
					style={`--activity-count: ${initialActivityPoints.length};`}
				>
					<div class="cyber-activity-scroll">
						<div
							class="cyber-activity-chart"
							data-activity-chart
							role="group"
							aria-label={`Development activity, ${periodLabels[initialPeriod]}`}
						>
							<div class="cyber-activity-grid" aria-hidden="true">
								<span></span><span></span><span></span>
							</div>
							<div class="cyber-activity-bars" data-activity-bars>
								{
									initialActivityPoints.map((point, index) => {
										const blocks = activityBlockCount(point);
										const label = activityPointLabel(point);
										const labelText = point.key.slice(5).replace("-", "/");
										return (
											<button
												type="button"
												class="cyber-activity-bar"
												data-activity-bar
												data-activity-blocks={blocks}
												data-incomplete={
													isActivityPartial(point) ? "true" : undefined
												}
												data-tooltip={label}
												aria-label={label}
												style={`--activity-index: ${index}; --activity-block-count: ${blocks};`}
											>
												<span class="cyber-activity-stack" aria-hidden="true">
													{ACTIVITY_BLOCK_COLORS.map((color, level) => (
														<span
															class="cyber-activity-block"
															data-active={level < blocks}
															style={`--block-color: ${color};`}
														/>
													))}
												</span>
												<time
													class="cyber-activity-bar-label"
													dateTime={point.key}
													data-label-visible={
														activityLabelIsVisible(
															index,
															initialActivityPoints.length,
														)
															? "true"
															: undefined
													}
												>
													{labelText}
												</time>
											</button>
										);
									})
								}
							</div>
						</div>
					</div>
				</div>
				<p
					class="cyber-activity-empty"
					data-activity-empty
					hidden={initialHasActivity}
				>
					No activity recorded for this period.
				</p>
				<script
					type="application/json"
					data-activity-data
					set:html={JSON.stringify(activity)}
				/>
			</section>
			<div
				class="mt-4 bg-[color:var(--bg-color)] border border-[color:var(--panel-border)] rounded-xl p-4"
			>
				<div class="flex items-center gap-4 mb-3">
					<div
						class="text-[color:var(--text-muted)] text-xs font-semibold tracking-wider whitespace-nowrap"
					>
						Languages
					</div>
					<div
						class="flex-1 flex h-2 rounded-full overflow-hidden bg-[color:var(--panel-border)]"
					>
						{
							statusData.languages.map((lang) => (
								<div
									style={`width: ${lang.value}%; background-color: ${lang.color};`}
									title={`${lang.label} ${lang.value}%`}
									class="h-full"
								/>
							))
						}
					</div>
				</div>
				<div class="flex flex-wrap gap-x-4 gap-y-2 mt-2">
					{
						statusData.languages.map((lang) => (
							<div class="flex items-center text-xs">
								<span
									class="w-2.5 h-2.5 rounded-full mr-2"
									style={`background-color: ${lang.color};`}
								/>
								<span class="text-[color:var(--text-muted)] mr-1.5">
									{lang.label}
								</span>
								<span class="font-bold text-[color:var(--text-main)]">
									{lang.value}%
								</span>
							</div>
						))
					}
				</div>
			</div>
		</div>
	</div>
</div>

<script>
	import {
		ACTIVITY_BLOCK_COLORS,
		type ActivityData,
		type ActivityPeriod,
		activityBlockCount,
		activityPointLabel,
		isActivityPartial,
		selectActivityRange,
	} from "../../../utils/activity";

	const clientPeriodLabels: Record<ActivityPeriod, string> = {
		"90d": "Last 90 days",
		"12m": "Last 12 months",
		all: "All time",
	};

	function isRecord(value: unknown): value is Record<string, unknown> {
		return typeof value === "object" && value !== null;
	}

	function isActivityData(value: unknown): value is ActivityData {
		if (!isRecord(value) || typeof value.rangeEnd !== "string") return false;
		return value.version === 2 && Array.isArray(value.daily);
	}

	function isPeriod(value: string | undefined): value is ActivityPeriod {
		return value === "90d" || value === "12m" || value === "all";
	}

	function pointDateLabel(key: string, period: ActivityPeriod): string {
		return period === "90d"
			? key.slice(5).replace("-", "/")
			: key.replaceAll("-", "/");
	}

	function renderActivity(
		root: HTMLElement,
		data: ActivityData,
		period: ActivityPeriod,
	): void {
		const bars = root.querySelector<HTMLElement>("[data-activity-bars]");
		const chart = root.querySelector<HTMLElement>("[data-activity-chart]");
		const empty = root.querySelector<HTMLElement>("[data-activity-empty]");
		if (!bars || !chart || !empty) return;

		const points = selectActivityRange(data, period);
		root
			.querySelector<HTMLElement>(".cyber-activity-chart-shell")
			?.style.setProperty("--activity-count", String(points.length));
		chart.setAttribute(
			"aria-label",
			`Development activity, ${clientPeriodLabels[period]}`,
		);
		bars.replaceChildren();

		let active = 0;
		for (const [index, point] of points.entries()) {
			const blocks = activityBlockCount(point);
			if (blocks > 0) active++;
			const tooltip = activityPointLabel(point);
			const bar = document.createElement("button");
			bar.type = "button";
			bar.className = "cyber-activity-bar";
			bar.dataset.activityBar = "true";
			bar.dataset.activityBlocks = String(blocks);
			if (isActivityPartial(point)) bar.dataset.incomplete = "true";
			bar.dataset.tooltip = tooltip;
			bar.setAttribute("aria-label", tooltip);
			bar.style.setProperty("--activity-index", String(index));
			bar.style.setProperty("--activity-block-count", String(blocks));
			const stack = document.createElement("span");
			stack.className = "cyber-activity-stack";
			stack.setAttribute("aria-hidden", "true");
			for (const [level, color] of ACTIVITY_BLOCK_COLORS.entries()) {
				const block = document.createElement("span");
				block.className = "cyber-activity-block";
				block.dataset.active = String(level < blocks);
				block.style.setProperty("--block-color", color);
				stack.append(block);
			}
			bar.append(stack);

			const label = document.createElement("time");
			label.className = "cyber-activity-bar-label";
			label.dateTime = point.key;
			if (
				index % Math.ceil(points.length / 4) === 0 ||
				index === points.length - 1
			) {
				label.dataset.labelVisible = "true";
			}
			label.textContent = pointDateLabel(point.key, period);
			bar.append(label);
			bars.append(bar);
		}

		empty.hidden = active > 0;
		empty.textContent = partial
			? "Activity data is unavailable for part of this period."
			: "No activity recorded for this period.";
	}

	for (const root of document.querySelectorAll<HTMLElement>(
		"[data-activity-root]",
	)) {
		const dataElement = root.querySelector<HTMLScriptElement>(
			"[data-activity-data]",
		);
		if (!dataElement) continue;
		let data: ActivityData;
		try {
			const parsed: unknown = JSON.parse(dataElement.textContent ?? "");
			if (!isActivityData(parsed)) throw new Error("Invalid activity data");
			data = parsed;
		} catch {
			const empty = root.querySelector<HTMLElement>("[data-activity-empty]");
			if (empty) empty.hidden = false;
			continue;
		}

		let period: ActivityPeriod = "90d";
		const updatePeriodButtons = () => {
			for (const button of root.querySelectorAll<HTMLButtonElement>(
				"[data-activity-period]",
			)) {
				button.setAttribute(
					"aria-pressed",
					String(button.dataset.activityPeriod === period),
				);
			}
		};

		for (const button of root.querySelectorAll<HTMLButtonElement>(
			"[data-activity-period]",
		)) {
			button.addEventListener("click", () => {
				if (!isPeriod(button.dataset.activityPeriod)) return;
				period = button.dataset.activityPeriod;
				updatePeriodButtons();
				renderActivity(root, data, period);
			});
		}
		renderActivity(root, data, period);
	}
</script>
